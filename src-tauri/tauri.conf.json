{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "filo",
  "version": "1.3.0",
  "identifier": "io.github.aelfat.filo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "filo",
        "decorations": false,
        "width": 1100,
        "height": 750,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["icons/doc.ico"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "log", "md", "csv"],
        "name": "Documento di testo",
        "description": "Documento di testo",
        "role": "Editor"
      },
      {
        "ext": ["json"],
        "name": "Documento JSON",
        "description": "Documento JSON",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "Documento XML",
        "description": "Documento XML",
        "role": "Editor"
      },
      {
        "ext": ["filo"],
        "name": "Documento filo",
        "description": "Documento filo con metadati",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Italian", "English", "German", "French"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
